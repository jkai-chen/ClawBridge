{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:clawbridge:dispatcher-model:v1",
	"title": "ClawBridge dispatcher-model API v1",
	"description": "Generated from dispatcher-agent/src/schema.ts by dispatcher-agent/scripts/write-schema.ts; edit that file, not this one. Every request sends the header ClawBridge-Model-API: 1. Errors are 4xx/503 with an ErrorResponse body.",
	"x-operations": {
		"agent_config": {
			"method": "POST",
			"path": "/v1/dispatcher-model/agent/config",
			"auth": "agent_credential",
			"request": "#/$defs/AgentConfigRequest",
			"response": "#/$defs/AgentConfigResponse"
		},
		"agent_renew": {
			"method": "POST",
			"path": "/v1/dispatcher-model/agent/renew",
			"auth": "agent_credential",
			"request": "#/$defs/AgentRenewRequest",
			"response": "#/$defs/AgentRenewResponse"
		},
		"agent_test_result": {
			"method": "POST",
			"path": "/v1/dispatcher-model/agent/test-result",
			"auth": "agent_credential",
			"request": "#/$defs/AgentTestResultRequest",
			"response": "#/$defs/OkResponse"
		},
		"agent_status": {
			"method": "POST",
			"path": "/v1/dispatcher-model/agent/status",
			"auth": "agent_credential",
			"request": "#/$defs/AgentStatusRequest",
			"response": "#/$defs/OkResponse"
		},
		"hello": {
			"method": "GET",
			"path": "/v1/dispatcher-model/hello",
			"auth": "project_token",
			"response": "#/$defs/HelloResponse"
		},
		"cases_next": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/next",
			"auth": "project_token",
			"request": "#/$defs/CasesNextRequest",
			"response": "#/$defs/CasesNextResponse"
		},
		"tool_read_issue_facts": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/read_issue_facts",
			"auth": "project_token",
			"request": "#/$defs/Tool_read_issue_facts_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_list_domain": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/list_domain",
			"auth": "project_token",
			"request": "#/$defs/Tool_list_domain_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_list_sessions": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/list_sessions",
			"auth": "project_token",
			"request": "#/$defs/Tool_list_sessions_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_session_activity": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/session_activity",
			"auth": "project_token",
			"request": "#/$defs/Tool_session_activity_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_list_decisions": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/list_decisions",
			"auth": "project_token",
			"request": "#/$defs/Tool_list_decisions_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_recommend": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/recommend",
			"auth": "project_token",
			"request": "#/$defs/Tool_recommend_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_decide": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/decide",
			"auth": "project_token",
			"request": "#/$defs/Tool_decide_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_reply": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/reply",
			"auth": "project_token",
			"request": "#/$defs/Tool_reply_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_abstain": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/abstain",
			"auth": "project_token",
			"request": "#/$defs/Tool_abstain_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_route_notice": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/route_notice",
			"auth": "project_token",
			"request": "#/$defs/Tool_route_notice_Request",
			"response": "#/$defs/ToolResponse"
		},
		"tool_ask_session": {
			"method": "POST",
			"path": "/v1/dispatcher-model/cases/{case_id}/tools/ask_session",
			"auth": "project_token",
			"request": "#/$defs/Tool_ask_session_Request",
			"response": "#/$defs/ToolResponse"
		}
	},
	"$defs": {
		"ErrorResponse": {
			"type": "object",
			"required": [
				"error"
			],
			"properties": {
				"error": {
					"enum": [
						"unauthorized",
						"unsupported_version",
						"agent_cap",
						"case_not_found",
						"case_closed",
						"case_leased",
						"deadline_passed",
						"tool_refused",
						"invalid_argument",
						"not_in_case",
						"cap_reached",
						"guardrail",
						"server_busy",
						"conflict",
						"rate_limited"
					]
				},
				"tool": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"supported": {
					"type": "array",
					"items": {
						"type": "integer"
					}
				},
				"retry_after": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"AgentConfigRequest": {
			"type": "object",
			"required": [
				"instance_id"
			],
			"properties": {
				"instance_id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				}
			},
			"additionalProperties": false
		},
		"AgentConfigResponse": {
			"type": "object",
			"required": [
				"config_revision",
				"provider",
				"projects",
				"limits",
				"binding_secret",
				"status"
			],
			"properties": {
				"config_revision": {
					"type": "integer",
					"minimum": 1
				},
				"provider": {
					"type": "object",
					"required": [
						"id",
						"api",
						"base_url",
						"model",
						"key"
					],
					"properties": {
						"id": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"api": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"base_url": {
							"type": "string",
							"pattern": "^(https://[^/?#@\\s]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?)(/[^?#\\s]*)?$"
						},
						"model": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"key": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"projects": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"project_id",
							"token",
							"expires_at"
						],
						"properties": {
							"project_id": {
								"type": "string",
								"pattern": "^prj_[0-9a-f]{32}$"
							},
							"token": {
								"type": "string",
								"minLength": 1
							},
							"expires_at": {
								"type": "string",
								"format": "date-time"
							}
						}
					}
				},
				"limits": {
					"type": "object",
					"required": [
						"max_input_tokens_per_run",
						"max_output_tokens_per_run"
					],
					"properties": {
						"max_input_tokens_per_run": {
							"type": "integer",
							"minimum": 1
						},
						"max_output_tokens_per_run": {
							"type": "integer",
							"minimum": 1
						}
					}
				},
				"binding_secret": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]{43}$"
				},
				"status": {
					"enum": [
						"pending_test",
						"active"
					]
				}
			}
		},
		"AgentRenewRequest": {
			"type": "object",
			"required": [
				"binding_secret"
			],
			"properties": {
				"binding_secret": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]{43}$"
				}
			},
			"additionalProperties": false
		},
		"AgentRenewResponse": {
			"type": "object",
			"required": [
				"projects"
			],
			"properties": {
				"projects": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"project_id",
							"token",
							"expires_at"
						],
						"properties": {
							"project_id": {
								"type": "string",
								"pattern": "^prj_[0-9a-f]{32}$"
							},
							"token": {
								"type": "string",
								"minLength": 1
							},
							"expires_at": {
								"type": "string",
								"format": "date-time"
							}
						}
					}
				}
			}
		},
		"AgentTestResultRequest": {
			"anyOf": [
				{
					"type": "object",
					"required": [
						"binding_secret",
						"config_revision",
						"result"
					],
					"properties": {
						"binding_secret": {
							"type": "string",
							"pattern": "^[A-Za-z0-9_-]{43}$"
						},
						"config_revision": {
							"type": "integer",
							"minimum": 1
						},
						"result": {
							"type": "string",
							"const": "active"
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"binding_secret",
						"config_revision",
						"result",
						"reason"
					],
					"properties": {
						"binding_secret": {
							"type": "string",
							"pattern": "^[A-Za-z0-9_-]{43}$"
						},
						"config_revision": {
							"type": "integer",
							"minimum": 1
						},
						"result": {
							"type": "string",
							"const": "failed"
						},
						"reason": {
							"enum": [
								"invalid_key",
								"no_model_access",
								"quota",
								"rate_limited",
								"no_tool_use",
								"egress_blocked",
								"provider_error",
								"timeout"
							]
						}
					},
					"additionalProperties": false
				}
			]
		},
		"AgentStatusRequest": {
			"type": "object",
			"required": [
				"binding_secret",
				"status"
			],
			"properties": {
				"binding_secret": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]{43}$"
				},
				"status": {
					"enum": [
						"ok",
						"provider_auth"
					]
				}
			},
			"additionalProperties": false
		},
		"OkResponse": {
			"type": "object",
			"required": [
				"ok"
			],
			"properties": {
				"ok": {
					"type": "boolean",
					"const": true
				}
			}
		},
		"HelloResponse": {
			"type": "object",
			"required": [
				"project_id",
				"enabled",
				"provider",
				"model",
				"caps",
				"opt_in_tools",
				"deadline_seconds",
				"server_time"
			],
			"properties": {
				"project_id": {
					"type": "string",
					"pattern": "^prj_[0-9a-f]{32}$"
				},
				"enabled": {
					"type": "boolean"
				},
				"provider": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"model": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"caps": {
					"type": "object",
					"required": [
						"runs_per_hour",
						"runs_per_day"
					],
					"properties": {
						"runs_per_hour": {
							"type": "integer",
							"minimum": 0
						},
						"runs_per_day": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				"opt_in_tools": {
					"type": "array",
					"items": {
						"enum": [
							"route_notice",
							"ask_session"
						]
					}
				},
				"deadline_seconds": {
					"type": "integer",
					"minimum": 30,
					"maximum": 300
				},
				"server_time": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"Case": {
			"type": "object",
			"required": [
				"case_id",
				"kind",
				"deadline",
				"deadline_ms",
				"subject",
				"reason_codes",
				"facts"
			],
			"properties": {
				"case_id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"kind": {
					"enum": [
						"advise",
						"decide",
						"chat"
					]
				},
				"deadline": {
					"type": "string",
					"format": "date-time"
				},
				"deadline_ms": {
					"type": "integer",
					"minimum": 0
				},
				"subject": {
					"type": "object",
					"required": [
						"type",
						"id"
					],
					"properties": {
						"type": {
							"anyOf": [
								{
									"type": "string",
									"const": "proposal"
								},
								{
									"type": "string",
									"const": "assignment"
								},
								{
									"type": "string",
									"const": "notice"
								},
								{
									"type": "string",
									"const": "message"
								}
							]
						},
						"id": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					}
				},
				"permitted_actions": {
					"type": "array",
					"items": {
						"enum": [
							"confirm",
							"escalate",
							"wait",
							"decline",
							"route",
							"release_pending",
							"release"
						]
					}
				},
				"reason_codes": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]{0,63}$"
					}
				},
				"facts": {
					"type": "object",
					"properties": {
						"issue": {
							"type": "object",
							"required": [
								"id",
								"identifier",
								"state_type",
								"project_id",
								"labels"
							],
							"properties": {
								"id": {
									"type": "string",
									"format": "uuid"
								},
								"identifier": {
									"type": "string",
									"maxLength": 32
								},
								"state_type": {
									"type": "string",
									"pattern": "^[a-z][a-z0-9_]{0,63}$"
								},
								"project_id": {
									"anyOf": [
										{
											"type": "string",
											"format": "uuid"
										},
										{
											"type": "null"
										}
									]
								},
								"labels": {
									"type": "array",
									"items": {
										"type": "string",
										"maxLength": 128
									}
								}
							}
						},
						"session": {
							"type": "object",
							"required": [
								"id",
								"name",
								"principal",
								"presence",
								"status"
							],
							"properties": {
								"id": {
									"type": "string",
									"minLength": 1,
									"maxLength": 128
								},
								"name": {
									"type": "string",
									"maxLength": 128
								},
								"principal": {
									"type": "string",
									"pattern": "^p_[A-Za-z0-9_-]{1,64}$"
								},
								"presence": {
									"anyOf": [
										{
											"type": "string",
											"const": "active"
										},
										{
											"type": "string",
											"const": "stale"
										}
									]
								},
								"status": {
									"anyOf": [
										{
											"type": "string",
											"const": "active"
										},
										{
											"type": "string",
											"const": "retired"
										},
										{
											"type": "string",
											"const": "moved"
										}
									]
								}
							}
						},
						"domain_matches": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"domain",
									"by"
								],
								"properties": {
									"domain": {
										"type": "string",
										"minLength": 1,
										"maxLength": 128
									},
									"by": {
										"anyOf": [
											{
												"type": "string",
												"const": "project"
											},
											{
												"type": "string",
												"const": "label"
											}
										]
									}
								}
							}
						},
						"holders": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"session_id",
									"since"
								],
								"properties": {
									"session_id": {
										"type": "string",
										"minLength": 1,
										"maxLength": 128
									},
									"since": {
										"type": "string",
										"format": "date-time"
									}
								}
							}
						}
					}
				},
				"untrusted": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string",
							"maxLength": 1024
						},
						"description_excerpt": {
							"type": "string",
							"maxLength": 4096
						},
						"truncated": {
							"type": "boolean"
						}
					}
				},
				"message": {
					"type": "object",
					"required": [
						"from",
						"text"
					],
					"properties": {
						"from": {
							"type": "object",
							"required": [
								"session",
								"principal"
							],
							"properties": {
								"session": {
									"type": "string",
									"maxLength": 128
								},
								"principal": {
									"type": "string",
									"pattern": "^p_[A-Za-z0-9_-]{1,64}$"
								}
							}
						},
						"text": {
							"type": "string",
							"maxLength": 4096
						}
					}
				}
			}
		},
		"CasesNextRequest": {
			"type": "object",
			"required": [
				"wait_seconds"
			],
			"properties": {
				"wait_seconds": {
					"type": "integer",
					"minimum": 0,
					"maximum": 30
				}
			},
			"additionalProperties": false
		},
		"CasesNextResponse": {
			"type": "object",
			"required": [
				"case"
			],
			"properties": {
				"case": {
					"anyOf": [
						{
							"type": "object",
							"required": [
								"case_id",
								"kind",
								"deadline",
								"deadline_ms",
								"subject",
								"reason_codes",
								"facts"
							],
							"properties": {
								"case_id": {
									"type": "string",
									"minLength": 1,
									"maxLength": 128
								},
								"kind": {
									"enum": [
										"advise",
										"decide",
										"chat"
									]
								},
								"deadline": {
									"type": "string",
									"format": "date-time"
								},
								"deadline_ms": {
									"type": "integer",
									"minimum": 0
								},
								"subject": {
									"type": "object",
									"required": [
										"type",
										"id"
									],
									"properties": {
										"type": {
											"anyOf": [
												{
													"type": "string",
													"const": "proposal"
												},
												{
													"type": "string",
													"const": "assignment"
												},
												{
													"type": "string",
													"const": "notice"
												},
												{
													"type": "string",
													"const": "message"
												}
											]
										},
										"id": {
											"type": "string",
											"minLength": 1,
											"maxLength": 128
										}
									}
								},
								"permitted_actions": {
									"type": "array",
									"items": {
										"enum": [
											"confirm",
											"escalate",
											"wait",
											"decline",
											"route",
											"release_pending",
											"release"
										]
									}
								},
								"reason_codes": {
									"type": "array",
									"items": {
										"type": "string",
