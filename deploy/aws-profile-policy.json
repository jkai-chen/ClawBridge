{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadForChecks",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeInstances",
        "ec2:DescribeAddresses",
        "ec2:DescribeVolumes",
        "ec2:DescribeSecurityGroups",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListDailyBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": {"StringLike": {"s3:prefix": "postgres/daily/*"}}
    },
    {
      "Sid": "RunFixedScriptsOnTheInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:instance/INSTANCE_ID",
        "arn:aws:ssm:REGION::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadAndStopThoseScripts",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:CancelCommand"],
      "Resource": "*"
    },
    {
      "Sid": "ShortLivedSecretParameters",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:DeleteParameter"],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/clawbridge/INSTANCE_ID/*"
    },
    {
      "Sid": "EncryptOnlyThroughSSM",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:GenerateDataKey"],
      "Resource": "*",
      "Condition": {"StringEquals": {"kms:ViaService": "ssm.REGION.amazonaws.com"}}
    }
  ]
}
