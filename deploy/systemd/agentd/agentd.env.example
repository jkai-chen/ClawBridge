# /etc/clawbridge-agentd/agentd.env, root 0600. The launcher token is not
# here: it is in launcher.env, written by `operator launcher-token create
# --out`, never by hand.
CLAWBRIDGE_SERVER_URL=https://bridge.example.com
# The same two images as proxy.env, character for character.
CLAWBRIDGE_AGENT_IMAGE=sha256:<64 hex>
CLAWBRIDGE_EGRESS_IMAGE=sha256:<64 hex>
CLAWBRIDGE_EGRESS_POLICY_DIR=/var/lib/clawbridge-agentd/policy
CLAWBRIDGE_AGENTD_DOCKER=/run/clawbridge-agentd/docker.sock
