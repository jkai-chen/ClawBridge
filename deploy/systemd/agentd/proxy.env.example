# /etc/clawbridge-agentd/proxy.env, root 0644: no secrets. The proxy builds
# the fixed container specs from these; agentd.env must carry the same.
CLAWBRIDGE_SERVER_URL=https://bridge.example.com
# Pinned by the release's digest line (ghcr.io/jkai-chen/<name>@sha256:…,
# from AGENT-IMAGE-DIGEST.txt and AGENTD-IMAGE-DIGEST.txt) as pulled into
# cbagent's daemon, or by image ID (sha256:…) for an image built and loaded
# offline.
CLAWBRIDGE_AGENT_IMAGE=sha256:<64 hex>
CLAWBRIDGE_EGRESS_IMAGE=sha256:<64 hex>
CLAWBRIDGE_EGRESS_POLICY_DIR=/var/lib/clawbridge-agentd/policy
