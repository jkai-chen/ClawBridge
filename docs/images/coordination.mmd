%% Source of docs/images/coordination.svg. After editing, regenerate the SVG from the repo root with:
%%   npx -y @mermaid-js/mermaid-cli@11.4.2 -b white -c cfg.json -i docs/images/coordination.mmd -o docs/images/coordination.svg
%% where cfg.json contains: {"htmlLabels":false,"flowchart":{"htmlLabels":false}}
%% (htmlLabels off makes labels SVG text, not foreignObject, so the image renders through an img tag.)
%% ClawBridge v1.0.0: how people and agents coordinate
flowchart TB
  subgraph MACHINE["Each person's own machine (one per teammate)"]
    PERSON(["Person<br/>owner · lead · engineer · reviewer"])
    CLI["clawbridge CLI / TUI<br/>device key in the OS key store"]
    AGENTS["Coding agents<br/>Claude Code · Codex<br/>one session each"]
    MCP["clawbridge mcp<br/>messages · claims · task-board tools"]
  end

  subgraph SERVER["ClawBridge server · PostgreSQL"]
    BUS["Coordination bus<br/>sessions · acked inboxes · threads<br/>claims · audit log"]
    SYNC["Linear sync<br/>webhooks + poll<br/>writes as the ClawBridge app"]
    INTAKE["Intake queue<br/>who asked, proven<br/>from Linear history"]
    DISP["Dispatcher (optional)<br/>domains · trusted sessions<br/>rules + guardrails"]
    ESC["Escalations<br/>a person decides"]
  end

  SANDBOX["Model sandbox (optional)<br/>dispatcher agent in a<br/>rootless container"]
  LLM(["Model provider<br/>owner's own key"])
  LINEAR[("Linear<br/>issues · labels · comments")]

  PERSON --> CLI
  AGENTS <-->|MCP| MCP
  CLI -->|signed requests| BUS
  MCP <-->|"② claim · messages<br/>live stream wakes idle agents"| BUS

  BUS -->|"③ pending claim"| DISP
  DISP -->|"④ confirm a trusted session"| BUS
  DISP -->|anything else| ESC
  CLI -.->|"person answers"| ESC

  DISP <-->|"cases (model mode)"| SANDBOX
  SANDBOX -->|egress proxy only| LLM
  ESC ~~~ SANDBOX
  LINEAR ~~~ INTAKE

  BUS -->|"⑤ claimed / released"| SYNC
  SYNC <-->|"① needs-agent · delegate · @mention<br/>⑤ marker comment · agent-working label"| LINEAR
  SYNC --> INTAKE
  INTAKE -->|notice to the coordinator| BUS

  classDef person fill:#fff4d6,stroke:#b8860b,color:#222
  classDef local fill:#e8f1ff,stroke:#3a6fb0,color:#111
  classDef server fill:#eaf7ea,stroke:#3c8a3c,color:#111
  classDef guard fill:#fdecea,stroke:#b03a2e,color:#111
  classDef ext fill:#f3eefc,stroke:#6b4fa3,color:#111
  class PERSON person
  class CLI,AGENTS,MCP local
  class BUS,INTAKE,SYNC server
  class DISP,ESC guard
  class SANDBOX,LINEAR,LLM ext
  style MACHINE fill:#f7faff,stroke:#3a6fb0
  style SERVER fill:#f6fbf6,stroke:#3c8a3c

